// Prisma schema – SQLite for local-first deployment
// Run: npx prisma db push

generator client {
  provider      = "prisma-client-js"
  // Pin targets so the Docker image (Debian Bookworm-slim, libssl 3) builds deterministically.
  // "native" keeps macOS dev working; "debian-openssl-3.0.x" matches the runtime base image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id                          String   @id @default(uuid())
  filename                    String
  originalExt                 String
  status                      String   @default("queued")
  // queued | processing | completed | failed | cancelled
  progress                    Int      @default(0)
  stage                       String   @default("upload")
  // upload | validate | repair | convert | embed | done
  inputPath                   String
  // AI metadata for traceability — which provider/model processed this job?
  aiProvider                  String?
  aiModel                     String?
  // AI performance tracking (updated as the job runs)
  aiTotalTokens               Int? // cumulative tokens used across all AI calls
  aiTotalDurationMs           Int? // cumulative AI call wall time
  aiCallCount                 Int? // number of AI calls made
  aiGenerationTokensPerSecond Float? // server-reported generation rate (OMLX)
  aiPromptTokensPerSecond     Float? // server-reported prompt-evaluation rate (OMLX)
  // Path to a per-job log file (newline-delimited JSON entries)
  logPath                     String?
  outputPath                  String?
  errorMsg                    String?
  metadata                    String? // JSON blob
  report                      String? // JSON blob – validation / repair report
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Ebook library – stores managed books after conversion
model Book {
  id                     String                  @id @default(uuid())
  title                  String
  // Optional Vietnamese title override — used by the cover generator so
  // bìa sách prints the Vietnamese title even when the imported `title`
  // is the original-language title (e.g. Chinese for translated tu tiểu
  // thuyệt). Falls back to `title` when null.
  titleVi                String?
  author                 String
  language               String                  @default("vi")
  description            String?
  publisher              String?
  publishDate            String?
  identifier             String? // ISBN or other identifier
  series                 String? // Series name
  seriesIndex            Float? // Position within series (e.g. 1, 2, 2.5)
  rating                 Int? // 1-10 (Calibre-style, displayed as 1-5 stars)
  coverPath              String? // path to extracted cover image
  filePath               String // absolute path to EPUB file in library dir
  fileSize               Int // bytes
  originalFilename       String
  tags                   String? // JSON: string[]
  notes                  String?
  readProgress           Int                     @default(0) // 0-100
  readStatus             String                  @default("unread") // unread | reading | read | archived
  isFavorite             Boolean                 @default(false)
  lastRead               DateTime?
  watermarks             String? // JSON: string[] – phrases to strip when serving chapters
  // Pre-generated audiobook support
  ttsBackend             String                  @default("vieneu") // vieneu | piper | moss-nano
  audiobookStatus        String                  @default("none") // none | generating | ready | partial | failed
  audiobookGeneratedAt   DateTime?
  audiobookDurationMs    Int? // total duration across all generated chapters
  addedAt                DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  // Shelf memberships
  shelfBooks             ShelfBook[]
  // Pre-generation data
  voices                 Voice[]
  characters             Character[]
  audiobookChapters      AudiobookChapter[]
  illustrations          Illustration[]
  chapterAttributions    ChapterAttribution[]
  chapterVoicePlans      ChapterVoicePlan[]
  characterRelationships CharacterRelationship[]
  pendingBibleDiffs      PendingBibleDiff[]
  bibleRefreshLogs       BibleRefreshLog[]
  conversationState      BookConversationState?

  @@index([addedAt])
  @@index([language])
  @@index([readStatus])
  @@index([lastRead])
  @@index([isFavorite])
}

// ── TTS Voice & Character ───────────────────────────────────────────────────
// Per-book voice definitions (each voice = a reference audio sample).
// Voices are used to clone a specific speaker (e.g. "Narrator", "Linh", "Phong").
model Voice {
  id             String   @id @default(uuid())
  bookId         String // per-book voices (so different books can have different narrator voices)
  name           String // "Narrator", "Linh", "Phong", "Default Male", ...
  description    String? // optional human description
  refAudioPath   String // absolute path to reference WAV (10-30 sec clip)
  language       String   @default("vi")
  isDefault      Boolean  @default(false) // exactly one per book used for narration
  // Optional emotion/pace hints injected into the MOSS-TTS prompt
  defaultSpeed   Float? // 0.5 - 2.0
  defaultEmotion String? // calm | sad | tense | romantic | angry | excited | neutral
  // ── Voice category (kind) ─────────────────────────────────────────────
  // narrator : the book's main narrator voice (one per book; isDefault=true)
  // character: a distinct voice assigned to a specific named character
  // common   : part of the shared "minor character / crowd" pool — minor
  //            characters (role=minor/crowd) get randomly assigned to one
  //            of these so the audiobook doesn't reuse the same voice for
  //            every passer-by
  kind           String   @default("character") // narrator | character | common
  // Underlying built-in VieNeu name (e.g. "Bình An", "Ngọc Lan") used by
  // the TTS server. For cloned voices (refAudioPath != ""), this is null.
  // For common-pool voices, this is the rotation base — we pick a different
  // pool entry per character so they're perceptually distinct.
  builtinName    String? // "Bình An" | "Ngọc Lan" | null=cloned
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  characters Character[]

  @@index([bookId])
  @@index([bookId, kind])
}

// Character → Voice mapping. Lets the pre-generation engine pick the right
// voice for each line of dialogue.
model Character {
  id        String   @id @default(uuid())
  bookId    String
  name      String // character name as it appears in the text (e.g. "Linh")
  voiceId   String? // null = use book's default voice
  notes     String?
  // ── Character role (for common-voice routing) ──────────────────────────
  // main      : protagonist / major character — gets dedicated voice
  // supporting: recurring but not main — gets dedicated voice
  // minor     : appears briefly, low lines — uses common voice pool
  // crowd     : anonymous background (e.g. "tiếng la", "người qua đường") —
  //             random common voice + slight variation per occurrence
  role      String   @default("supporting") // main | supporting | minor | crowd
  // Detected age (estimated from speech patterns) — used to fine-tune
  // voice selection: "young" prefers Ngọc Linh/Trúc Ly/Xuân Vĩnh,
  // "mature" prefers Ngọc Lan/Mỹ Duyên/Bình An/Gia Bảo/Đức Trí/Trọng Hữu.
  age       String? // young | mature | old | null=unknown
  // Detected gender — drives the strongest voice-selection signal:
  // wrong-gender voice is jarring, so we penalize gender mismatch by -20 in
  // scoreVoice(). Without this column stored, the picker falls back to age-
  // only and frequently gives a male a female voice (or vice versa).
  gender    String? // male | female | null=unknown
  // Detected tone (one short word: calm/cheerful/cold/mysterious/serious/…)
  // — additional signal for the picker. Persisted so voice re-selection on
  // the same character stays consistent across sessions.
  tone      String? // calm | cheerful | cold | mysterious | serious | warm | angry | sad | …
  createdAt DateTime @default(now())

  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  voice Voice? @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  // Inverse relations — Character Bible (see below). Owned by CharacterProfile
  // (1:1), CharacterChapterAppearance (1:N). CharacterAlias (1:N) holds the
  // per-alias confidence + source tracking; the legacy JSON `aliases` column
  // was retired in migration 20260724000000_add_character_alias_confidence.
  // CharacterRelationship has its own (bookId, fromCharId, toCharId) keys
  // and doesn't need Character refs.

  profile           CharacterProfile?
  appearances       CharacterChapterAppearance[]
  aliases           CharacterAlias[]
  relationshipsFrom CharacterRelationship[]      @relation("RelationshipFrom")
  relationshipsTo   CharacterRelationship[]      @relation("RelationshipTo")

  @@unique([bookId, name])
  @@index([bookId])
  @@index([bookId, role])
}

// ── Character alias table ────────────────────────────────────────────────────
// Per-alias row for a Character. Replaces the legacy `Character.aliases`
// JSON-string column with structured rows so we can track the alias source
// (user-edited vs LLM-detected vs merged-in) AND a confidence score that
// drives the "needs review" badge in the merge/split UI.
//
// Migration 20260724000000_add_character_alias_confidence created this
// table, backfilled the existing JSON aliases as `source='legacy'`,
// `confidence=1.0`, then dropped the legacy JSON column.
model CharacterAlias {
  id                String   @id @default(uuid())
  characterId       String
  alias             String
  // 0..1. LLM-detected aliases arrive lower than user-edited ones; the
  // alias-confidence helper scores based on the detector's fold method
  // (exact > substring > levenshtein > llm-only) plus a sampleLines bonus.
  confidence        Float    @default(1.0)
  // 'user' (manually added or split-confirmed) | 'llm' (detected by Python
  // character_detector.py) | 'merge' (absorbed from another character via
  // /api/library/[id]/characters/merge) | 'legacy' (backfilled from the
  // retired JSON column).
  source            String   @default("user")
  // Optional chapter index where the alias was first detected. Drives the
  // "introduced in chapter N" tooltip in the UI.
  detectedInChapter Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, alias])
  @@index([characterId])
  @@index([source, confidence])
}

// ── Character Bible (LLM-driven character knowledge base) ──────────────────
// Per-character profile. Free-text fields tracked by source ('llm' /
// 'user' / 'mixed') so the merge pipeline can preserve user-locked fields
// without overwriting them with LLM outputs. See src/lib/db/character-bible.ts.
model CharacterProfile {
  characterId       String   @id
  description       String?
  personality       String?
  speechStyle       String?
  // One-paragraph physical-appearance description (gender, age, hair/eye
  // colour + style, distinguishing clothing/jewelry/weapon, posture). Used
  // as a visual anchor when generating chapter illustrations so a
  // character wears the same robe / has the same hair across chapters.
  // Extracted by the LLM during character detection; user-editable.
  // "unspecified" if the text gives no physical detail.
  visualDescription String?
  // Same JSON shape as fieldSources above; tracks whether visualDescription
  // was set by the LLM or hand-edited by the user.
  visualSource      String?  @default("llm")
  fieldSources      String? // JSON: { description?: 'llm'|'user', personality?: 'llm'|'user', speechStyle?: 'llm'|'user', visualDescription?: 'llm'|'user' }
  source            String   @default("llm") // 'llm' | 'user' | 'mixed'
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Directed graph edges between two characters (e.g. parent / sibling /
// ally / rival). Composite-unique on (bookId, from, to, relationship) so
// duplicate upserts collapse.
model CharacterRelationship {
  id             String   @id @default(uuid())
  bookId         String
  fromCharId     String
  toCharId       String
  relationship   String
  notes          String?
  source         String   @default("llm") // 'llm' | 'user' | 'mixed'
  asOfChapterIdx Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("RelationshipFrom", fields: [fromCharId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("RelationshipTo", fields: [toCharId], references: [id], onDelete: Cascade)

  @@unique([bookId, fromCharId, toCharId, relationship])
  @@index([bookId])
}

// Per-character per-chapter occurrence count. Composite-unique on
// (characterId, chapterIndex) so duplicate upserts collapse and the
// mentions counter can be incremented atomically.
model CharacterChapterAppearance {
  id           String   @id @default(uuid())
  characterId  String
  chapterIndex Int
  mentions     Int      @default(1)
  analyzedAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, chapterIndex])
  @@index([characterId])
}

// User-review queue for conflicting Character Bible patches. Status:
// 'pending' (initial, awaiting user), 'applied' (merged), 'rejected'
// (dismissed), 'stale' (chapter gone or reordered).
model PendingBibleDiff {
  id        String   @id @default(uuid())
  bookId    String
  patch     String // JSON: BibleDiffPatch — full LLM proposal
  status    String   @default("pending") // pending | applied | rejected | stale
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, status])
}

// ── Bible refresh idempotency log ───────────────────────────────────────────
// One row per (bookId, chapterIndex). Lets the bible pipeline short-circuit
// "already-completed" refreshes without re-running the LLM. See
// src/lib/ai/character-bible.ts::writeRefreshLog.
model BibleRefreshLog {
  bookId        String
  chapterIndex  Int
  version       Int      @default(1)
  status        String   @default("applied") // applied | failed | skipped | conflict
  appliedCount  Int      @default(0)
  queuedCount   Int      @default(0)
  conflictCount Int      @default(0)
  durationMs    Int      @default(0)
  lastError     String?
  analyzedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, chapterIndex])
  @@index([bookId])
}

// ── Conversation-state seed (parser carry-over across chapters) ────────────
// One row per book. `payload` is a JSON snapshot of the last chapter's
// conversation graph (who was on-screen, what they said last). The parser
// reads + extends this for the next chapter so attributes stay coherent
// across long runs. See src/lib/db/conversation-state.ts.
model BookConversationState {
  bookId           String   @id
  lastChapterIndex Int
  payload          String // JSON: ConversationStateSnapshot
  parserVersion    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// One row per chapter of a book. Tracks pre-generated audio for fast playback.
model AudiobookChapter {
  id           String    @id @default(uuid())
  bookId       String
  chapterFile  String // e.g. "chapter001.xhtml" or "EPUB/chapter001.xhtml" — matches parseEpub htmlFiles
  chapterTitle String? // pre-extracted for UI display
  audioPath    String? // absolute path to concatenated WAV (data/audiobooks/<bookId>/<chapterFile>.wav)
  durationMs   Int? // total audio length
  sizeBytes    Int? // WAV file size on disk
  status       String    @default("pending") // pending | generating | ready | failed | skipped
  progress     Int       @default(0) // 0-100 within this chapter
  errorMsg     String?
  generatedAt  DateTime?
  // Config used for generation (so regeneration is deterministic)
  configHash   String? // hash of (voices + characters + backend) used to generate this chapter

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterFile])
  @@index([bookId, status])
}

// Shelves – user-defined reading lists / collections
model Shelf {
  id          String      @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  books       ShelfBook[]

  @@index([sortOrder])
}

model ShelfBook {
  shelfId  String
  bookId   String
  position Int      @default(0)
  addedAt  DateTime @default(now())

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([shelfId, bookId])
}

// ── App settings (singleton row) ────────────────────────────────────────────
// One row, id="singleton". Stores user-configured preferences for AI providers,
// TTS providers, and default conversion options. Read by all AI endpoints
// to route to the selected backend (OMLX local, MiniMax cloud, etc.).
model User {
  id           String        @id @default(uuid())
  username     String        @unique @default("admin")
  name         String        @default("Local user")
  email        String?       @unique
  passwordHash String?
  role         String        @default("USER")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  settings     UserSettings?
  auditLogs    AuditLog[]    @relation("AuditActor")
  targetLogs   AuditLog[]    @relation("AuditTarget")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actorId     String?
  targetUserId String?
  details     String?
  createdAt   DateTime @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model UserSettings {
  id String @id @default(uuid())

  userId String @unique

  aiProvider           String  @default("omlx-local")
  aiApiKey             String?
  aiBaseUrl            String?
  aiAllowInsecureTls   Boolean @default(false)
  aiModel              String  @default("default")
  aiMaxTokens          Int     @default(4096)
  aiTemperature     Float   @default(0.2)
  aiThinkingCombine Boolean @default(true)
  aiThinkingFullLLM Boolean @default(false)

  ttsProvider String @default("vieneu")

  defaultAiEnhance        Boolean @default(true)
  defaultAiWatermarkClean Boolean @default(true)
  defaultDeepFormat       Boolean @default(false)
  defaultLanguage         String  @default("vi")
  defaultReaderFriendly   Boolean @default(true)

  aiEnhanceConcurrency Int @default(3)

  imageProvider   String  @default("none")
  imageApiKey     String?
  imageBaseUrl    String?
  imageAllowInsecureTls Boolean @default(false) // disable cert validation for private/self-signed image gateways
  imageModel      String  @default("dall-e-3")
  imageStyle      String  @default("bw-anime")
  imageMaxPerBook Int     @default(6)

  theme String @default("system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id String @id @default("singleton")

  // ── AI provider for text tasks (EPUB repair, character detection, etc.) ──
  aiProvider        String  @default("omlx-local")
  // omlx-local | minimax-cloud | openai | custom
  aiApiKey          String? // encrypted-at-rest API key (MiniMax, OpenAI, ...)
  aiBaseUrl         String? // optional override for OpenAI-compatible endpoints
  aiAllowInsecureTls Boolean @default(false) // disable certificate validation for private/self-signed custom gateways
  aiModel           String  @default("default") // model identifier
  // Upper bound on response tokens per AI call.
  //   Chapter-enhancement uses this to cap the output budget — too high
  //   and the local OMLX model balloons the KV cache past the 12 GB RAM
  //   ceiling (memory_guard_tier abort), which crashes the entire book
  //   conversion. Lowering this is the user-facing knob to fix OOM.
  //   Default 4096 ≈ safe for a 9B-class 4-bit model on Apple Silicon.
  aiMaxTokens       Int     @default(4096)
  aiTemperature     Float   @default(0.2)
  // Per-mode `enable_thinking` override for the chapter-attribution
  // analyzer. Thinking ON for the chunked Combine mode (small batches,
  // accuracy over speed). Thinking OFF for the whole-chapter 'full-llm'
  // mode (large prompt, token budget is the constraint — chain-of-thought
  // would burn the output cap before the model emits any rows).
  // 2026-07-12: surfaced in the Settings UI as two toggles so users can
  // override per model + workload.
  aiThinkingCombine Boolean @default(true)
  aiThinkingFullLLM Boolean @default(false)

  // ── TTS provider ──────────────────────────────────────────────────────────
  ttsProvider String @default("vieneu")
  // vieneu | piper | moss-nano

  // ── Conversion defaults ────────────────────────────────────────────────────
  defaultAiEnhance        Boolean @default(true)
  defaultAiWatermarkClean Boolean @default(true)
  // Deep chapter formatting (paragraphs, dialogue, scene breaks).
  // Slower than defaultAiEnhance but produces much nicer-looking novels.
  defaultDeepFormat       Boolean @default(false)
  defaultLanguage         String  @default("vi")
  // Strip heavy CSS (animations, blur, text-shadow, hyphens, fixed-position
  // decorative pseudos) + use minimal stylesheet so the output renders
  // correctly on Onyx Boox (Neoreader), Kobo Aura, and older Kindles.
  // Default true: most web-novel source EPUBs ship with CSS that crashes
  // those devices' renderers after the first 1–2 pages.
  defaultReaderFriendly   Boolean @default(true)

  // ── AI enhancement runtime tuning (live-readable from settings page) ──
  // Number of chapter-enhancement LLM calls in flight per batch.
  // Read fresh from this column each batch in chapter-enhancer.ts, so
  // changing the value from the settings page takes effect on the
  // NEXT batch of the currently-running job (no worker restart needed).
  // Bound between 1 and 16 — higher values saturate Apple Silicon KV
  // cache on a 9B 4Bit model and slow overall throughput.
  aiEnhanceConcurrency Int @default(3)

  // ── Image generation (chapter illustrations + AI covers) ────────────────
  imageProvider   String  @default("none") // none | openai | minimax | custom
  imageApiKey     String? // separate from text API key
  imageBaseUrl    String? // for custom image endpoints
  imageAllowInsecureTls Boolean @default(false) // disable cert validation for private/self-signed image gateways
  imageModel      String  @default("dall-e-3") // model id
  imageStyle      String  @default("bw-anime") // bw-anime | bw-manga | bw-ink | bw-sketch | ink | sketch | watercolor | manga | none
  // Maximum chapters to auto-illustrate per book. Set to 0 to disable.
  imageMaxPerBook Int     @default(6)

  // ── UI preferences ────────────────────────────────────────────────────────
  theme String @default("system") // system | light | dark

  // ── Worker performance tuning ──────────────────────────────────────────────
  // Max number of conversions processed simultaneously by the worker.
  // Each conversion is independent, so concurrency > 1 gives near-linear
  // speedup IF your AI provider can handle the parallel load.
  workerConcurrency        Int @default(2) // 1=sequential, 2-4=parallel recommended
  // Within a single conversion, max chapters to deep-format in parallel.
  // 1=sequential (safe for slow providers), 2-4=parallel (faster but more API load).
  workerChapterConcurrency Int @default(1)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── Watermark memory (cross-book learning) ──────────────────────────────────
// Persistent catalog of phrases that have been seen & stripped from one or
// more books. The conversion pipeline reads this BEFORE running its own
// regex scan, so phrases flagged in a previous conversion are stripped
// instantly on the next book that contains them — no re-detection cost.
// Phrases can also be added/removed manually from /settings (Watermarks tab)
// to pre-seed the memory before any uploads, or to remove false-positives
// the auto-detector picked up (e.g. legitimate repeating phrases).
model WatermarkMemory {
  id          String   @id @default(uuid())
  // The phrase to strip. Stored verbatim (case-insensitive equality on read).
  phrase      String   @unique
  // Where this phrase came from: 'auto' (detected by regex on a prior job),
  // 'user' (manually added in /settings), or 'imported' (seeded by an
  // initial script). Drives the UI badge color.
  source      String   @default("auto") // auto | user | imported
  // Total number of books this phrase has been stripped from. Helps the UI
  // sort by "most common watermark". On every successful strip we do
  // `increment hitCount`, lastSeenAt=now.
  hitCount    Int      @default(1)
  lastSeenAt  DateTime @default(now())
  firstSeenAt DateTime @default(now())
  // When this row was first created (alias of firstSeenAt but kept distinct
  // so audit logs don't tie creation time to detection history).
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hitCount])
  @@index([source])
}

// ── AI-generated chapter illustrations ─────────────────────────────────────
// One row per illustrated chapter. AI scores each chapter and only generates
// images for "highlight" chapters (visually rich scenes).
model Illustration {
  id           String   @id @default(uuid())
  bookId       String
  chapterIndex Int // 0-based index into parseEpub().htmlFiles
  chapterTitle String // cached for UI display
  prompt       String // the prompt used for image generation
  imagePath    String // absolute path to the PNG file on disk
  imageModel   String? // model that generated it (e.g. "dall-e-3")
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterIndex])
  @@index([bookId])
}

// ── Cached chapter-level speaker attribution ─────────────────────────────
// One row per chapter. The payload is a JSON map of paragraph index →
// { speaker, confidence, source, evidence?, state? } where source is one of
// "parser" (VnCoreNLP dependency parse), "regex" (existing regex evidence),
// "conversation" (stateful scene/turn fusion), "llm" (oMLX fallback for
// zero-anaphora), or "default" (no attribution found). The
// mtime of the source chapter file is cached so we re-attribute only when
// the user re-uploads or edits the chapter — otherwise we serve the cached
// version straight from SQLite in O(1).
model ChapterAttribution {
  id            String   @id @default(uuid())
  bookId        String
  chapterIndex  Int // 0-based index into parseEpub().htmlFiles
  payload       String // JSON: Record<number, { speaker?: string, confidence: number, source: string, evidence?: [], state?: {} }>
  sourceMtime   BigInt // mtime of the chapter HTML file when attribution ran
  parserVersion String   @default("conversation-v3") // which model produced the result
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterIndex])
  @@index([bookId])
}

// Per-chapter, per-sentence voice assignment plan used by the Voice Assign
// Editor. Sentences are derived from the chapter HTML at edit time; the plan
// stores the discovered character + the chosen voice for each sentence so the
// user can correct mis-attributions. Sentences with no voice assigned fall back
// to the narration (default) voice at playback / generation time.
model ChapterVoicePlan {
  id            String   @id @default(uuid())
  bookId        String
  chapterIndex  Int // 0-based index into parseEpub().htmlFiles
  // JSON array of sentence entries in reading order:
  // { i: number, text: string, charId: string|null, voiceId: string|null,
  //   source: "narration" | "character" | "manual" }
  sentences     String
  sourceMtime   BigInt // mtime of the chapter HTML file when sentences were derived
  updatedAt     DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterIndex])
  @@index([bookId])
}
