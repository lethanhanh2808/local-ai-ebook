# Environment – ebook-converter
# Copy to .env.local and fill in values

# ── OMLX AI Service ───────────────────────────────────────────────────────────
OMLX_BASE_URL=http://127.0.0.1:8080/v1
OMLX_API_KEY=your-omlx-api-key-here
# Model name as listed in OMLX – change to match what is loaded
OMLX_MODEL=default

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── SQLite path (relative to project root) ────────────────────────────────────
DATABASE_URL="file:./data/ebook-converter.db"

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_FILE_SIZE_MB=100

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
