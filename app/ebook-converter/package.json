{
  "name": "ebook-converter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx watch src/worker/index.ts",
    "worker:prod": "node dist/worker/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:python": "bash scripts/run-python-tests.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/00-smoke.spec.ts",
    "test:e2e:local": "tsx scripts/e2e-preflight.ts && playwright test",
    "test:e2e:local:smoke": "tsx scripts/e2e-preflight.ts && playwright test e2e/00-smoke.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run build && npm run test:e2e:local:smoke",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:migrate:create": "bash scripts/db-migrate.sh --create",
    "db:snapshot": "bash scripts/db-snapshot.sh",
    "db:verify": "bash scripts/db-verify.sh",
    "db:status": "bash scripts/db-migrate.sh --skip-snapshot --skip-restart --no-verify --help",
    "db:push:danger": "echo 'Use `npm run db:migrate:create -- --name <x>` instead. `prisma db push` is unsafe on a live DB (2026-07-12 corruption incident). If you REALLY need it, run: bash scripts/db-migrate.sh --skip-restart --skip-snapshot && prisma db push && bash scripts/db-verify.sh && docker compose up -d app worker' && exit 1",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "bullmq": "^5.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.3.19",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.418.0",
    "next": "^15.5.20",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "yauzl": "^3.1.3",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.16",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "postcss": "$postcss"
  }
}
